ARG BASE_IMAGE=rapptor-stack-cpu:reserved-workers
FROM ${BASE_IMAGE}

ENV PYTHONPATH=/opt/rapptor-prediction/src \
    RAPPTOR_MODEL_DIR=/models \
    RAPPTOR_DATA_ROOT=/data

USER root
WORKDIR /opt/rapptor-prediction
COPY --chown=10001:10001 services/prediction/src ./src
RUN mkdir -p /data/jobs /data/redis && chown -R 10001:10001 /data

USER 10001
EXPOSE 8000
CMD ["python", "-m", "prediction_service"]
