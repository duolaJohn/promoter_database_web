RAPPTOR_MODEL_VERSION=candidate-github-93cf
RAPPTOR_CGR_CACHE_ROOT=/data/cgr-cache
RAPPTOR_CGR_VERSION=cgr-128-v1
RAPPTOR_MODEL_HOST_DIR=./model-assets/candidate-github-93cf
RAPPTOR_GPU_INDEX=0
RAPPTOR_API_PORT=8000
RAPPTOR_MAX_QUEUE_LENGTH=100
RAPPTOR_MIN_SCAN_STRIDE=1
RAPPTOR_DEFAULT_SCAN_STRIDE=1
# Full-position prediction artifacts are retained for 24 hours.
RAPPTOR_FILE_RETENTION_SECONDS=86400
RAPPTOR_TICKET_VALIDATION_MODE=disabled
# Production Cloudflare integration:
# RAPPTOR_TICKET_VALIDATION_MODE=cloudflare
# RAPPTOR_TICKET_CONSUME_URL=https://example/api/internal/prediction-tickets/consume
# RAPPTOR_TICKET_SERVICE_SECRET=replace-me
# RAPPTOR_JOB_CALLBACK_URL=https://example/api/internal/prediction-jobs
# RAPPTOR_JOB_CALLBACK_SECRET=replace-me
